# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
# Enable "Vault" for the app to allow auto-buy.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Signs offers so prices can't be tampered with before checkout (any long random string)
OFFER_SIGNING_SECRET=

# Public URL of the app (used for PayPal return/cancel URLs). Optional on Vercel.
APP_URL=

# Fixed conversion used to charge EGP prices in USD (PayPal does not settle EGP)
EGP_PER_USD=50

# Upstash Redis (price watches) — added via Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects /api/cron
CRON_SECRET=
